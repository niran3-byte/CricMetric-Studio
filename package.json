{
  "name": "cricmetric-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm test",
    "db:seed-sample": "tsx scripts/seed-sample.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "mongodb": "6.20.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.6.0",
    "esbuild": "0.25.5",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
